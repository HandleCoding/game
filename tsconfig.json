{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/api/src/**/*.ts",
    "packages/contracts/src/**/*.ts"
  ]
}