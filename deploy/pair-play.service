[Unit]
Description=Playroom friends game lobby
After=network.target

[Service]
Type=simple
User=pairplay
Group=pairplay
WorkingDirectory=/opt/pair-play
ExecStart=/usr/bin/node /opt/pair-play/server.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3210
Environment=DATA_DIR=/var/lib/pair-play
Environment=PUBLIC_ORIGIN=https://game.aicoding.ltd
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pair-play
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
